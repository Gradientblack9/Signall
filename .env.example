LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MIN_INTERVAL=4
# Optional alternatives: groq or ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
SIGNAL_DB=data/signal.db
SIGNAL_SCHEDULER=true
# Local single-user app. Set a token before exposing it beyond localhost.
SIGNAL_ACCESS_TOKEN=
